{
  "expo": {
    "name": "languageApp",
    "slug": "languageapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sprachbar-launcher.png",
    "scheme": "languageapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/sprachbar-launcher.png",
      "bundleIdentifier": "com.languageapp.sprachbar",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sprachbar uses the microphone so you can practice speaking during lessons and the placement test."
      },
      "appleTeamId": "LK42P468FB"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6d28d9",
        "foregroundImage": "./assets/images/sprachbar-foreground.png",
        "backgroundImage": "./assets/images/sprachbar-background.png",
        "monochromeImage": "./assets/images/sprachbar-monochrome.png"
      },
      "package": "com.languageapp.sprachbar",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/sprachbar-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sprachbar-mark.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#eceaf4",
          "dark": {
            "backgroundColor": "#0b0a10"
          }
        }
      ],
      "expo-localization",
      "expo-asset",
      "react-native-audio-api",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
