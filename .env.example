# Backend URL. "auto" (development only) uses the Mac's address from Metro, so a new
# Wi-Fi IP doesn't break the phone. Release builds need a real URL here.
EXPO_PUBLIC_API_URL=auto
# 1 = use the in-memory mock auth adapter (every code is 123456) instead of the backend
EXPO_PUBLIC_API_MOCK=0
# Google sign-in (Google Cloud Console OAuth client IDs). The web ID is the idToken audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android: not read by the app; create it in Google Cloud with package com.languageapp.sprachbar + your SHA-1.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# 1 = enable Sign in with Apple (iOS; needs a paid Apple Developer team). Rebuild after changing.
EXPO_PUBLIC_APPLE_SIGN_IN=0
